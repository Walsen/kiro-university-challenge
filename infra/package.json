{
  "name": "maze-game-platform-infra",
  "version": "0.1.0",
  "private": true,
  "description": "AWS CDK (TypeScript) infrastructure for the Maze Game Platform (Phase 2): the single shared backend stack and the GitHub Actions OIDC deploy role.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "synth": "cdk synth",
    "deploy": "cdk deploy MazeGamePlatform --require-approval never",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "aws-cdk": "^2.171.0",
    "esbuild": "0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.171.0",
    "constructs": "^10.4.2"
  }
}
