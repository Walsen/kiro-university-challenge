{
  "name": "maze-game-platform-infra",
  "version": "0.1.0",
  "private": true,
  "description": "AWS CDK (TypeScript) infrastructure for the Maze Game Platform (Phase 2): per-environment stacks and the GitHub Actions OIDC deploy roles.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "synth": "cdk synth",
    "synth:dev": "cdk synth MazeGamePlatform-dev",
    "synth:prod": "cdk synth MazeGamePlatform-prod",
    "deploy:dev": "cdk deploy MazeGamePlatform-dev --require-approval never",
    "deploy:prod": "cdk deploy MazeGamePlatform-prod --require-approval never",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "aws-cdk": "^2.171.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.171.0",
    "constructs": "^10.4.2"
  }
}
