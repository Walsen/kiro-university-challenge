{
  "mcpServers": {
    "awslabs.cloudwatch-applicationsignals-mcp-server": {
      "command": "uvx",
      "args": [
        "awslabs.cloudwatch-applicationsignals-mcp-server@latest"
      ],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR",
        "AWS_REGION": "us-east-1"
      },
      "disabled": false,
      "autoApprove": [
        "list_monitored_services",
        "query_sampled_traces",
        "search_transaction_spans",
        "audit_services",
        "analyze_canary_failures"
      ]
    },
    "awslabs.billing-cost-management-mcp-server": {
      "command": "uvx",
      "args": [
        "awslabs.billing-cost-management-mcp-server@latest"
      ],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR",
        "AWS_REGION": "us-east-1"
      },
      "disabled": false,
      "autoApprove": []
    },
    "awslabs.aws-pricing-mcp-server": {
      "command": "uvx",
      "args": [
        "awslabs.aws-pricing-mcp-server@latest"
      ],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR",
        "AWS_REGION": "us-east-1"
      },
      "disabled": true,
      "autoApprove": []
    }
  }
}
